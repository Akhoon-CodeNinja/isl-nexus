# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# PostgreSQL
DB_NAME=isl_backend
DB_USER=isl_admin
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# JWT
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7

# CORS (comma-separated origins of the admin web portal / Flutter dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Dev-only: `flutter run -d chrome` uses a different random localhost port
# every run, so the fixed CORS_ALLOWED_ORIGINS above won't match it. Set
# this to True in your LOCAL .env to allow any localhost/127.0.0.1 port.
# Leave it unset (or False) in production.
# CORS_ALLOW_LOCALHOST_ANY_PORT=True
